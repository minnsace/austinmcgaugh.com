---
import type { CollectionEntry } from "astro:content";
import { formatDate, journalTags } from "../lib/content";

interface Props {
  posts: CollectionEntry<"journal">[];
  activeTag?: string;
}

const { posts, activeTag } = Astro.props;
const tags = journalTags(posts);
---

{
  tags.length > 0 && (
    <nav aria-label="Tags">
      <ul class="tag-list">
        <li>
          <a href="/journal/" aria-current={activeTag ? undefined : "page"}>
            All
          </a>
        </li>
        {tags.map((tag) => (
          <li>
            <a href={`/journal/tags/${tag.slug}/`} aria-current={activeTag === tag.slug ? "page" : undefined}>
              {tag.name}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

{
  posts.length === 0 ? (
    <div class="empty">
      <h2>No posts yet.</h2>
      <p>Published articles and videos will appear here.</p>
    </div>
  ) : (
    <ol class="feed">
      {posts.map((post) => (
        <li>
          <a class="feed-card" href={`/journal/${post.id}/`} style="--mark: var(--color-violet)">
            <span class="badge-row">
              <span class="badge">{post.data.type === "video" ? "Video" : "Article"}</span>
              {post.data.draft && <span class="draft-badge">Draft</span>}
            </span>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          </a>
        </li>
      ))}
    </ol>
  )
}
