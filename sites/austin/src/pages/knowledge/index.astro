---
import ContentPanel from "@digital-forge/ui/ContentPanel.astro";
import KnowledgeList from "../../components/KnowledgeList.astro";
import PageHeader from "../../components/PageHeader.astro";
import { loadKnowledge } from "../../lib/content";
import Base from "../../layouts/Base.astro";

const posts = await loadKnowledge();
const description = "Articles and videos by Austin McGaugh.";
---

<Base title="Knowledge" description={description} current="knowledge">
  <ContentPanel>
    <PageHeader kicker="Notes and video" title="Knowledge" intro={description} symbol="book" tone="violet" />
    <p class="cluster">
      <a class="text-link" href="/knowledge/rss.xml">Subscribe with RSS</a>
    </p>
    <KnowledgeList posts={posts} />
  </ContentPanel>
</Base>
