---
import { getEntry, render } from "astro:content";
import ContentPanel from "@digital-forge/ui/ContentPanel.astro";
import PageHeader from "../../components/PageHeader.astro";
import ProjectMeta from "../../components/ProjectMeta.astro";
import { loadProjects } from "../../lib/content";
import { projectGraph } from "../../lib/jsonld";
import { absoluteUrl } from "../../lib/urls";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const projects = await loadProjects();
  return projects.map((project) => ({ params: { slug: project.id } }));
}

const { slug } = Astro.params;
const project = slug ? await getEntry("projects", slug) : undefined;
if (!project || (project.data.draft && import.meta.env.PROD)) {
  throw new Error(`Missing project: ${slug}`);
}

const { Content } = await render(project);
const canonical = absoluteUrl(`/projects/${project.id}/`);
---

<Base
  title={project.data.title}
  description={project.data.description}
  current="projects"
  ogType="article"
  published={project.data.date}
  jsonLd={projectGraph(project, canonical)}
>
  <ContentPanel class="shard-title">
    <a class="back-link" href="/projects/">All projects</a>
    <PageHeader
      kicker={project.data.kind}
      title={project.data.title}
      intro={project.data.description}
      symbol="cube"
      tone="electric"
    />
    <ProjectMeta project={project} />
    <p class="cluster">
      {
        project.data.url && project.data.linkLabel && (
          <a class="button" href={project.data.url} target="_blank" rel="noopener noreferrer">
            {project.data.linkLabel}
            <span class="visually-hidden"> (opens in a new tab)</span>
          </a>
        )
      }
      {
        project.data.steam && (
          <a class="button" href={project.data.steam} target="_blank" rel="noopener noreferrer">
            View on Steam
            <span class="visually-hidden"> (opens in a new tab)</span>
          </a>
        )
      }
      {
        project.data.repository && (
          <a class="text-link" href={project.data.repository} target="_blank" rel="noopener noreferrer">
            {project.data.repositoryLabel ?? "Source"}
            <span class="visually-hidden"> (opens in a new tab)</span>
          </a>
        )
      }
    </p>
  </ContentPanel>
  <ContentPanel class="shard-read">
    <div class="prose">
      <Content />
    </div>
  </ContentPanel>
</Base>
