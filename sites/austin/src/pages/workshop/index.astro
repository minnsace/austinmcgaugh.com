---
import ContentPanel from "@digital-forge/ui/ContentPanel.astro";
import PageHeader from "../../components/PageHeader.astro";
import { formatDate, loadWorkshop } from "../../lib/content";
import { brand } from "../../brand/manifest";
import Base from "../../layouts/Base.astro";

const updates = await loadWorkshop();
const description = "Minnsace Inc., the independent game studio founded by Austin McGaugh.";
---

<Base title="Workshop" description={description} current="workshop">
  <ContentPanel variant="hero">
    <PageHeader kicker={brand.organization.name} title="Workshop" intro="Minnsace Inc. is my company. I build software and games." symbol="anvil" tone="amber" />
  </ContentPanel>
  <ContentPanel class="shard-read">
    <div class="prose">
      <h2>The studio</h2>
      <p>
        <a href={brand.organization.url}>{brand.organization.name}</a> is an independent game studio. I founded it. The released game,
        <a href="/projects/deadlight-tavern/">Deadlight Tavern</a>, is available free on Steam.
      </p>
      <p>
        <a href="/projects/free-snake-game/">FreeSnakeGame.com</a> is one of my projects.
        <a href="/projects/the-lethecary/">The Lethecary</a> is in development.
      </p>
      <p>
        The studio site is <a href="https://minnsace.com/">minnsace.com</a>. Code is on
        <a href="https://github.com/minnsace">GitHub</a>, and games are on <a href="https://itch.io/profile/minnsace">itch.io</a>.
      </p>
      <p>
        Email me at <a href={`mailto:${brand.email}`}>{brand.email}</a> about the studio, a game, or other work.
      </p>
    </div>
  </ContentPanel>
  <ContentPanel class="shard-rail">
    <h2>Now</h2>
    {
      updates.length === 0 ? (
        <div class="empty">
          <p>No progress notes yet.</p>
        </div>
      ) : (
        <ol class="feed">
          {updates.map((update) => (
            <li>
              <a class="feed-card" href={`/workshop/${update.id}/`} style="--mark: var(--color-amber)">
                <span class="badge-row">
                  {update.data.draft && <span class="draft-badge">Draft</span>}
                  <time datetime={update.data.date.toISOString()}>{formatDate(update.data.date)}</time>
                </span>
                <h2>{update.data.title}</h2>
                <p>{update.data.description}</p>
              </a>
            </li>
          ))}
        </ol>
      )
    }
  </ContentPanel>
</Base>
